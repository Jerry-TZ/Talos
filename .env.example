# ── Talos 配置 ──
# 把本文件复制成 .env(已在 .gitignore,不会进 git),填好后每次启动自动加载,
# 就不用每次在终端 $env:... 手动设了。真实环境变量优先级更高(可临时覆盖 .env)。
#
#   PowerShell:  Copy-Item .env.example .env   然后编辑 .env

# 选一个厂商: claude / openai / gemini / deepseek / glm / kimi
TALOS_PROVIDER=glm

# 只填你用的那个厂商的 key
ZHIPUAI_API_KEY=在这里粘贴你的智谱key

# 其它厂商(用哪个就取消注释填哪个):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=

# 可选:覆盖默认模型(不填就用该厂商默认,如 glm 默认 glm-4.7-flash)
# TALOS_MODEL=glm-5.2
